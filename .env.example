# ─── Multi-Agent Decision Intelligence — env template ───
# Copy to .env and fill. Medical/Authentik vars removed vs upstream haidoc.

# ── App database (Postgres, shared by ConfigService + Orchestrator) ──
APP_DB_NAME=haidoc
APP_DB_USER=haidoc
APP_DB_PASSWORD=haidoc
APP_DB_PORT=5400
# Orchestrator legacy aliases (keep equal to APP_DB_*)
DB_NAME=haidoc
DB_USER=haidoc
DB_PASSWORD=haidoc

# ── Auth (local HS256 — no Authentik) ──
JWT_SECRET=change-me-dev-secret
# bcrypt hash of the admin registration secret (see plan.md step 6)
ADMIN_REGISTRATION_KEY=
SEED_ADMIN_PASSWORD=12345678

# ── LLM providers (agents call these via shared chat_completion) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Context Aggregator ──
AGGREGATOR_NAME=decision_aggregator

# ── Observability ──
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
